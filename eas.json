{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "APP_VARIANT": "development" } },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "https://erp.indradhar.in"
      }
    },
    "production": { "autoIncrement": true, "env": { "APP_VARIANT": "production", "EXPO_PUBLIC_API_BASE_URL": "https://erp.indradhar.in" } }
  },
  "submit": { "preview": {}, "production": {} }
}
